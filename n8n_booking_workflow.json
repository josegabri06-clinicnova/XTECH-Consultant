    {
      "parameters": {
        "jsCode": "const items = $input.all();\nfor (const item of items) {\n  const datePart = item.json.date.split('T')[0];\n  const [startStr, endStr] = item.json.slot.split(' - ');\n  item.json.startDateTime = `${datePart}T${startStr}:00`;\n  item.json.endDateTime = `${datePart}T${endStr}:00`;\n}\nreturn items;"
      },
